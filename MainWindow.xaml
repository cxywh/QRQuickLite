<Window x:Class="QRQuick.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="QR Quick Lite"
        Width="420" Height="360" MinWidth="360" MinHeight="320"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border x:Name="RootBorder" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1"
            Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 标题栏 -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center">
                    <Image Source="/Resources/app.ico" Width="18" Height="18"
                           RenderOptions.BitmapScalingMode="HighQuality" />
                    <TextBlock Text="QR Quick Lite" Style="{StaticResource TitleTextStyle}" Margin="8,0,0,0" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"
                            Margin="0,0,8,0">
                    <Button Content="设置" Style="{StaticResource CaptionButtonStyle}" Click="Settings_Click" />
                    <Button Content="最小化" Style="{StaticResource CaptionButtonStyle}" Width="52" Click="Minimize_Click" />
                    <Button Content="关闭" Style="{StaticResource CloseCaptionButtonStyle}" Click="Close_Click" />
                </StackPanel>
            </Grid>

            <!-- 主操作 -->
            <StackPanel Grid.Row="1" Margin="18,6,18,0">
                <Button x:Name="CaptureButton" Content="截图识别" Height="58" FontSize="18"
                        Style="{StaticResource PrimaryButtonStyle}" Click="Capture_Click" />
                <TextBlock x:Name="CaptureHotkeyText" Text="" HorizontalAlignment="Center"
                           Margin="0,8,0,0" Style="{StaticResource HintTextStyle}" />
            </StackPanel>

            <!-- 状态 -->
            <TextBlock x:Name="StatusText" Grid.Row="2" Margin="18,12,18,0"
                       TextWrapping="Wrap" Style="{StaticResource BodyTextStyle}"
                       Foreground="{StaticResource TextSecondaryBrush}" />

            <!-- 最近结果 -->
            <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="18,12,18,16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock Text="最近结果" Style="{StaticResource SectionTitleStyle}" Margin="0,0,0,6" />

                    <TextBlock x:Name="EmptyHint" Grid.Row="1" Text="按快捷键或点上方按钮，框选屏幕上的二维码。"
                               TextWrapping="Wrap" VerticalAlignment="Top"
                               Style="{StaticResource HintTextStyle}" />

                    <ScrollViewer x:Name="ResultScroll" Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                  Visibility="Collapsed">
                        <TextBlock x:Name="ResultText" TextWrapping="Wrap"
                                   Style="{StaticResource BodyTextStyle}" />
                    </ScrollViewer>

                    <StackPanel x:Name="ResultActions" Grid.Row="2" Orientation="Horizontal"
                                Margin="0,10,0,0" Visibility="Collapsed">
                        <Button Content="复制" Style="{StaticResource SecondaryButtonStyle}" Click="Copy_Click" />
                        <Button x:Name="CopyAllButton" Content="复制全部" Style="{StaticResource SecondaryButtonStyle}"
                                Margin="8,0,0,0" Visibility="Collapsed" Click="CopyAll_Click" />
                        <Button x:Name="OpenLinkButton" Content="打开链接" Style="{StaticResource LinkButtonStyle}"
                                Margin="12,0,0,0" Visibility="Collapsed" Click="OpenLink_Click" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
