<Window x:Class="QRQuick.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:QRQuick.Views"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="设置"
        Width="500" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBackgroundBrush}"
        FontFamily="{StaticResource AppFontFamily}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="0"
                            GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="{StaticResource WindowBackgroundBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="46" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 标题 -->
            <Grid Grid.Row="0" Background="#FFF8FAFC" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="设置" Style="{StaticResource TitleTextStyle}" Margin="16,0,0,0"
                           VerticalAlignment="Center" />
                <Button Content="关闭" Style="{StaticResource CloseCaptionButtonStyle}" HorizontalAlignment="Right"
                        Margin="0,0,10,0" VerticalAlignment="Center" Click="Close_Click" />
            </Grid>

            <!-- 内容 -->
            <StackPanel Grid.Row="1" Margin="16,14,16,16">

                <!-- 快捷键 -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Text="截图快捷键" Style="{StaticResource SectionTitleStyle}" />

                        <DockPanel>
                            <views:HotkeyBox x:Name="HotkeyControl" Width="210" DockPanel.Dock="Left" />
                            <TextBlock x:Name="HotkeyStatusText" Style="{StaticResource HintTextStyle}"
                                       Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>

                        <DockPanel Margin="0,10,0,0">
                            <Button Content="恢复默认（Alt+Q）" Style="{StaticResource LinkButtonStyle}"
                                    DockPanel.Dock="Right" Click="ResetHotkey_Click" />
                            <TextBlock Text="点击后按下新的组合键；必须有 Ctrl / Alt / Shift / Win 之一。修改立即生效并自动保存。"
                                       Style="{StaticResource HintTextStyle}" VerticalAlignment="Center" TextWrapping="Wrap" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!-- 右键菜单 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="资源管理器右键菜单" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="ExplorerMenuCheck" Content="在右键菜单中加入“二维码识别”"
                                  Style="{StaticResource AppCheckBoxStyle}" Checked="ExplorerMenu_Changed"
                                  Unchecked="ExplorerMenu_Changed" />
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="25,7,0,0" TextWrapping="Wrap"
                                   Text="在文件、文件夹或桌面空白处点击右键，选择“二维码识别”即可直接进入截图，不需要先打开本程序。只写入当前用户注册表，不需要管理员权限；关闭开关会立即删除这些菜单项。" />
                    </StackPanel>
                </Border>

                <!-- 识别后行为 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="识别后" Style="{StaticResource SectionTitleStyle}" />
                        <CheckBox x:Name="AutoOpenCheck" Content="自动打开识别到的网页"
                                  Style="{StaticResource AppCheckBoxStyle}" Checked="AutoOpen_Changed"
                                  Unchecked="AutoOpen_Changed" />
                        <TextBlock Style="{StaticResource HintTextStyle}" Margin="25,7,0,0" TextWrapping="Wrap"
                                   Text="识别到有效的 HTTP/HTTPS 网页链接后，自动使用系统默认浏览器打开。默认关闭。一次识别出多个不同链接时不会自动打开，只在结果中展示。" />
                    </StackPanel>
                </Border>

                <!-- 关闭行为 -->
                <Border Style="{StaticResource CardStyle}" Margin="0,12,0,0">
                    <StackPanel>
                        <TextBlock Text="关闭窗口时" Style="{StaticResource SectionTitleStyle}" />

                        <RadioButton x:Name="ExitRadio" Content="完全退出程序" Style="{StaticResource AppRadioButtonStyle}"
                                     GroupName="CloseBehavior" Checked="CloseBehavior_Changed" Margin="0,2,0,0" />
                        <RadioButton x:Name="TrayRadio" Content="最小化到托盘（快捷键继续可用）"
                                     Style="{StaticResource AppRadioButtonStyle}" GroupName="CloseBehavior"
                                     Checked="CloseBehavior_Changed" Margin="0,10,0,0" />

                        <CheckBox x:Name="TrayIconCheck" Content="在系统托盘显示图标"
                                  Style="{StaticResource AppCheckBoxStyle}" Margin="0,14,0,0"
                                  Checked="TrayIcon_Changed" Unchecked="TrayIcon_Changed" />
                    </StackPanel>
                </Border>

                <TextBlock x:Name="FooterHint" Style="{StaticResource HintTextStyle}" Margin="2,14,0,0"
                           Text="所有设置修改后立即保存，重启程序后依然有效。" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
