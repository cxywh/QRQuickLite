<UserControl x:Class="QRQuick.Views.HotkeyBox"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             FontFamily="{StaticResource AppFontFamily}">
    <Border x:Name="Box" BorderBrush="#FFC9D1DC" BorderThickness="1" CornerRadius="5" Background="White"
            Padding="12,7" Cursor="Hand" MouseLeftButtonDown="Box_MouseLeftButtonDown"
            Focusable="True" FocusVisualStyle="{x:Null}">
        <DockPanel>
            <TextBlock x:Name="ValueText" Text="Alt+Q" FontSize="13"
                       Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center" />
            <TextBlock x:Name="HintText" Text="点击后按下新快捷键" FontSize="11"
                       Foreground="{StaticResource TextMutedBrush}" HorizontalAlignment="Right"
                       VerticalAlignment="Center" />
        </DockPanel>
    </Border>
</UserControl>
